# Copy this file to .env and fill in your real key. Never commit the real .env.
#
# Any OpenAI-compatible endpoint works -- model ids live in backend/app/config.py.
#   DeepSeek (paid):                   https://api.deepseek.com/v1    key from https://platform.deepseek.com
#   OpenRouter (free tier available):  https://openrouter.ai/api/v1   key from https://openrouter.ai/keys

CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=your_deepseek_key_here

# Pinecone (for vector storage and embeddings)
PINECONE_API_KEY=your_pinecone_key_here
